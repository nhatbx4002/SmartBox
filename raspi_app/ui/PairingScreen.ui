    font-size: 20px;
    font-weight: 700;
}

#lblMcpSummary,
#lblStatus,
#lblVersion,
#lblHotline {
    color: #B0B0B0;
    font-family: "Be Vietnam Pro", "Arial", sans-serif;
    font-size: 16px;
    font-weight: 600;
}

#lblStatus {
    color: #FFFFFF;
}

#btnRetry {
    background-color: #1C1B1B;
    color: #FFFFFF;
    border: 2px solid #333333;
    border-radius: 18px;
    padding: 14px 18px;
    font-family: "Be Vietnam Pro", "Arial", sans-serif;
    font-size: 18px;
    font-weight: 800;
}

#btnRetry:hover {
    border-color: #FF6600;
}

#InfoCard {
    background-color: #121212;
    border: 1px solid #2A2A2A;
    border-radius: 24px;
}

#CodeCard {
    background-color: #0E0E0E;
    border: 1px solid #2A2A2A;
    border-radius: 28px;
}</string>
