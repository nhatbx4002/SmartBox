    font-size: 34px;
    font-weight: 900;
}

#lblPairingCode {
    color: #FF6600;
    background-color: #111111;
    border: 2px solid #FF6600;
    border-radius: 20px;
    padding: 18px 18px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 54px;
    font-weight: 900;
    letter-spacing: 6px;
    qproperty-alignment: AlignCenter;
}

#lblCountdown {
