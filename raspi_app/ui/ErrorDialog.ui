   <string notr="true">QWidget#ErrorDialogContent {
    background-color: rgba(10, 10, 10, 217); /* 85% opacity overlay */
    font-family: &quot;Be Vietnam Pro&quot;;
}

QFrame#dialogCard {
    background-color: #1C1B1B;
    border: 2px solid #333333;
    border-left: 6px solid #FF6600;
    border-radius: 24px;
}

QLabel#lblDialogIcon {
    background: transparent;
    border: none;
    color: #FFCC00;
    font-size: 72px;
}

QLabel#lblDialogTitle {
    background: transparent;
    border: none;
    color: #FFFFFF;
    font-size: 26px;
    font-weight: bold;
}

QFrame#lineSeparator {
    background-color: #333333;
    border: none;
}

QLabel#lblDialogMessage {
    background: transparent;
    border: none;
    color: #B0B0B0;
    font-size: 16px;
}

QPushButton#btnRetry {
    background-color: #FF6600;
    border: none;
    border-radius: 14px;
    color: #FFFFFF;
    font-size: 20px;
    font-weight: bold;
}

QPushButton#btnRetry:pressed {
    background-color: #E85C00;
}

QPushButton#btnRetry:disabled {
    background-color: #555555;
    color: #888888;
}

QPushButton#btnGoHome {
    background-color: #1C1C1C;
    border: 2px solid #333333;
    border-radius: 14px;
    color: #FFFFFF;
    font-size: 20px;
    font-weight: bold;
}

QPushButton#btnGoHome:pressed {
    background-color: #333333;
}

QLabel#lblHotline {
    background: transparent;
    border: none;
    color: #B0B0B0;
    font-size: 15px;
}</string>
