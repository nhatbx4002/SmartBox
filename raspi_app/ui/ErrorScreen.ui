    font-weight: bold;
}

QPushButton#btnRetry {
    background-color: #FF6600;
    border: none;
    border-radius: 16px;
    color: #1A1A1A;
    font-size: 22px;
    font-weight: bold;
    letter-spacing: 2px;
}

QPushButton#btnRetry:pressed {
    background-color: #E85C00;
}

QPushButton#btnRetry:disabled {
    background-color: #555555;
    color: #888888;
}

QLabel#lblCountdown {
    background: transparent;
    border: none;
    color: #666666;
    font-size: 13px;
}</string>
