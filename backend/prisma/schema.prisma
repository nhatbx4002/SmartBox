generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================
// Enums
// =======================

enum AdminRole {
  SUPER_ADMIN
  CABINET_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

enum CabinetStatus {
  ACTIVE
  INACTIVE
  OFFLINE
  CONFIGURING
}

enum CompartmentSize {
  SMALL
  LARGE
}

enum CompartmentStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum LockStatus {
  UNKNOWN
  LOCKED
  UNLOCKED
  FAULTY
}

enum DoorStatus {
  CLOSED
  OPEN
  UNKNOWN
}

enum RentalType {
  ONCE
  DAILY
  MONTHLY
}

enum PairingStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum RentalStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum LockerAction {
  OPENED
  CLOSED
  EXPIRED
  DENIED
  NO_SHOW
  HEARTBEAT
  FAULTY
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE_LOCATION
  UPDATE_LOCATION
  DELETE_LOCATION
  CREATE_CABINET
  UPDATE_CABINET
  DELETE_CABINET
  UNLOCK_COMPARTMENT
  CANCEL_RENTAL
  CREATE_ADMIN
  UPDATE_ADMIN
  DELETE_ADMIN
  ASSIGN_ADMIN_CABINET
  UNASSIGN_ADMIN_CABINET
  CREATE_PRICE_PLAN
  UPDATE_PRICE_PLAN
  DELETE_PRICE_PLAN
  CANCEL_PAIRING
}

enum NotificationType {
  RENTAL_EXPIRED
  CABINET_OFFLINE
  RENTAL_STARTED
  PAYMENT_SUCCESS
  HARDWARE_FAULT
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  PAYOS
}

enum PaymentSource {
  KIOSK
  APP
}

// =======================
// Models
// =======================

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(CABINET_ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs          AuditLog[]
  cabinetAssignments AdminCabinet[]
}

model User {
  id           String     @id @default(cuid())
  email        String?    @unique
  phone        String     @unique
  passwordHash String?
  name         String?
  fcmToken     String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  rentals       Rental[]
  notifications Notification[]

  @@index([phone])
  @@index([email])
}

model Location {
  id          String         @id @default(cuid())
  name        String
  address     String
  latitude    Float?
  longitude   Float?
  mapImageUrl String?
  status      LocationStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  cabinets Cabinet[]

  @@index([status])
}

model AdminCabinet {
  id        String   @id @default(cuid())
  adminId   String
  cabinetId String
  createdAt DateTime @default(now())

  admin   Admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)

  @@unique([adminId, cabinetId])
  @@index([cabinetId])
}

model Cabinet {
  id              String        @id @default(cuid())
  locationId      String
  name            String
  status          CabinetStatus @default(CONFIGURING)
  lastHeartbeatAt DateTime?
  configVersion   Int           @default(1)
  hardwareSerial  String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  location         Location       @relation(fields: [locationId], references: [id])
  compartments     Compartment[]
  mcpDevices       McpDevice[]
  logs             LockerLog[]
  adminAssignments AdminCabinet[]

  @@index([locationId])
  @@index([status])
  @@index([hardwareSerial])
}

model McpDevice {
  id        String   @id @default(cuid())
  cabinetId String
  bus       Int      @default(1)
  address   Int      @default(32)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cabinet            Cabinet       @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  lockCompartments   Compartment[] @relation("LockMcp")
  sensorCompartments Compartment[] @relation("SensorMcp")

  @@unique([cabinetId, bus, address])
  @@index([cabinetId])
}

model Compartment {
  id                String            @id @default(cuid())
  cabinetId         String
  name              String
  size              CompartmentSize
  mcp23017PinLock   Int
  mcp23017PinSensor Int
  lockMcpDeviceId   String
  sensorMcpDeviceId String
  status            CompartmentStatus @default(AVAILABLE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  cabinet         Cabinet     @relation(fields: [cabinetId], references: [id])
  lockMcpDevice   McpDevice  @relation("LockMcp", fields: [lockMcpDeviceId], references: [id], onDelete: SetNull)
  sensorMcpDevice McpDevice  @relation("SensorMcp", fields: [sensorMcpDeviceId], references: [id], onDelete: SetNull)
  rentals         Rental[]
  logs            LockerLog[]

  @@unique([cabinetId, name])
  @@index([cabinetId])
  @@index([lockMcpDeviceId])
  @@index([sensorMcpDeviceId])
  @@index([status])
}

model PairingSession {
  id                   String   @id @default(cuid())
  hardwareSerial       String
  discoveredMcpDevices Json
  pairingCode          String   @unique
  status               PairingStatus   @default(PENDING)
  cabinetId            String?  @unique
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([pairingCode])
  @@index([status, expiresAt])
  @@index([cabinetId])
}

model PricePlan {
  id           String          @id @default(cuid())
  name         String
  size         CompartmentSize
  rentalType   RentalType
  price        Int
  maxOpens     Int?
  durationDays Int
  description  String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  rentals Rental[]

  @@index([size, isActive])
  @@index([rentalType])
}

model Rental {
  id            String       @id @default(cuid())
  userId        String?
  compartmentId String
  pricePlanId   String
  code          String       @unique
  codeHash      String
  qrToken       String       @unique
  openCount     Int          @default(0)
  maxOpens      Int
  expiresAt     DateTime
  status        RentalStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user        User?       @relation(fields: [userId], references: [id])
  compartment Compartment @relation(fields: [compartmentId], references: [id])
  pricePlan   PricePlan   @relation(fields: [pricePlanId], references: [id])
  logs        LockerLog[]
  payment     Payment?

  @@index([code])
  @@index([qrToken])
  @@index([userId])
  @@index([compartmentId])
  @@index([status])
  @@index([expiresAt])
}

model LockerLog {
  id            String       @id @default(cuid())
  cabinetId     String?
  compartmentId String?
  rentalId      String?
  action        LockerAction
  attemptCount  Int          @default(0)
  success       Boolean
  ipAddress     String?
  deviceInfo    String?
  note          String?
  createdAt     DateTime     @default(now())

  cabinet     Cabinet?     @relation(fields: [cabinetId], references: [id])
  compartment Compartment? @relation(fields: [compartmentId], references: [id])
  rental      Rental?      @relation(fields: [rentalId], references: [id])

  @@index([compartmentId])
  @@index([cabinetId])
  @@index([rentalId])
  @@index([action])
  @@index([createdAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  adminId    String
  action     AuditAction
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  admin Admin @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  title     String
  body      String
  type      NotificationType
  data      Json?
  isRead    Boolean          @default(false)
  sentAt    DateTime         @default(now())
  createdAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type])
}

model Payment {
  id            String        @id @default(cuid())
  rentalId      String        @unique
  orderCode     Int           @unique
  amount        Int
  status        PaymentStatus @default(PENDING)
  paymentLinkId String?
  checkoutUrl   String?
  qrCode        String?
  method        PaymentMethod @default(PAYOS)
  source        PaymentSource @default(KIOSK)
  paidAt        DateTime?
  expiresAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  rental Rental @relation(fields: [rentalId], references: [id])

  @@index([orderCode])
  @@index([status])
}
